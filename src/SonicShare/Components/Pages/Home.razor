@page "/"
@inject NavigationManager NavManager

<div class="banner">
</div>


<div style="display:flex;justify-content: space-evenly;align-items: center;">

    <div class="btn-group">
        <ion-button size="large" shape="round" @onclick="GoToCategorySelectionPage">
            <ion-icon slot="icon-only" name="send" style="color:white"></ion-icon>
        </ion-button>
        <p>Send</p>
    </div>

    <div class="btn-group">
        <ion-button size="large" shape="round">
            <ion-icon slot="icon-only" name="download" style="color:white"></ion-icon>
        </ion-button>
        <p>Receive</p>
    </div>

    <div class="btn-group">
        <ion-button size="large" shape="round">
            <ion-icon slot="icon-only" name="star-half" style="color:white"></ion-icon>
        </ion-button>
        <p>Rate Us</p>
    </div>

</div>

<div style="display: flex; flex-direction: column; align-items: center; width: 100%;">
    <h2 class="ion-text-center ion-padding-horizontal ion-padding-top ion-padding-bottom" style="color: white; font-weight: 700; font-size: 28px; line-height: 1.2;">
        Share Files Seamlessly
    </h2>
    <p class="ion-text-center ion-padding-horizontal ion-padding-top ion-padding-bottom" style="color: white; font-weight: 400; font-size: 16px; line-height: 1.5;">
        Quickly exchange files with your contacts, ensuring a smooth and efficient sharing experience.
    </p>
</div>



<style>
    .btn-group {
        display: flex;
        flex-direction: column;
        align-items: center; /* center horizontally */
    }

    .banner {
        height: 40vh;
        background: url('/images/banner2.png') no-repeat center center;
        background-size: cover;
        border-bottom-left-radius: 30px;
        border-bottom-right-radius: 30px;
        background-position: left center;
        margin-bottom: 30px;
    }


    /* For screens larger than 600px */
    @@media (min-width: 601px) {
        .banner {
            background: url('/images/banner.jpg') repeat center center;
        }
    }
</style>


    